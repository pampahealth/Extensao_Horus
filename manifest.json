{
  "manifest_version": 3,
  "name": "Coletor Universal de Produtos",
  "version": "1.0.4",
  "description": "Coleta dados públicos de produtos",

  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "https://*.supabase.co/*"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scrape_universal.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "dist/background.js"
  }
}
