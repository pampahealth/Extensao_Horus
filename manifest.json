{
  "manifest_version": 3,
  "name": "Coletor Universal de Produtos",
  "version": "1.3.0",

  "permissions": ["storage"],
  "host_permissions": [
    "https://horus.saude.gov.br/*",
    "http://horus.saude.gov.br/*",
    "http://116.202.27.216/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://horus.saude.gov.br/*",
        "http://horus.saude.gov.br/*",
        "https://*.horus.saude.gov.br/*",
        "http://*.horus.saude.gov.br/*"
      ],
      "js": ["coleta-horus.js", "scrape_universal.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "Coletor Hórus"
  },

  "background": {
    "service_worker": "dist/background.js"
  }
}
